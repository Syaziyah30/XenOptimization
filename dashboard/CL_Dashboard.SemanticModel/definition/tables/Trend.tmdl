	/// Value of the variable ticked on the CL Correlation Scatter page (x axis)
	measure 'CL Scatter X Value' =
			VAR tag = SELECTEDVALUE ( 'CL Combined Variables'[Tag] )
			RETURN
			    IF ( NOT ISBLANK ( tag ), CALCULATE ( AVERAGE ( 'Trend'[Value] ), DimTag[Tag] = tag ) )
		formatString: #,0.0000
		lineageTag: 3faba75c-1aea-4c68-a002-d172ad2e0ac6

	measure 'CL Scatter X Axis Title' =
			VAR short = SELECTEDVALUE ( 'CL Combined Variables'[Short] )
			RETURN
			    IF ( ISBLANK ( short ), "Select a variable", short & " (" & SELECTEDVALUE ( 'CL Combined Variables'[Unit] ) & ")" )
		lineageTag: 25b642ab-4aa7-47b3-a20d-2fac66534497

	/// Pearson correlation of the ticked variable with CL1.PV over the 30-minute blocks in context
	measure 'CL Scatter Pearson r' =
			VAR pts =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( 'Trend'[DateTime 30min] ), REMOVEFILTERS ( DimTag ) ),
			            "@x", [CL Scatter X Value],
			            "@y", [CL1.PV (kW)]
			        ),
			        NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] )
			    )
			VAR mx = AVERAGEX ( pts, [@x] )
			VAR my = AVERAGEX ( pts, [@y] )
			VAR cov = SUMX ( pts, ( [@x] - mx ) * ( [@y] - my ) )
			VAR vx = SUMX ( pts, ( [@x] - mx ) ^ 2 )
			VAR vy = SUMX ( pts, ( [@y] - my ) ^ 2 )
			RETURN DIVIDE ( cov, SQRT ( vx ) * SQRT ( vy ) )
		formatString: 0.0000
		lineageTag: 6c48aa89-6676-4d18-909a-addb54a7e57c

	/// Least-squares slope: kW of CL1.PV per 1 unit of the ticked variable
	measure 'CL Scatter Slope' =
			VAR pts =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( 'Trend'[DateTime 30min] ), REMOVEFILTERS ( DimTag ) ),
			            "@x", [CL Scatter X Value],
			            "@y", [CL1.PV (kW)]
			        ),
			        NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] )
			    )
			VAR mx = AVERAGEX ( pts, [@x] )
			VAR my = AVERAGEX ( pts, [@y] )
			VAR cov = SUMX ( pts, ( [@x] - mx ) * ( [@y] - my ) )
			VAR vx = SUMX ( pts, ( [@x] - mx ) ^ 2 )
			VAR vy = SUMX ( pts, ( [@y] - my ) ^ 2 )
			RETURN DIVIDE ( cov, vx )
		formatString: #,0.0000
		lineageTag: 2a7e43af-9902-43ca-941d-96fe01aa90e3

	measure 'CL Scatter Points' =
			VAR pts =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( 'Trend'[DateTime 30min] ), REMOVEFILTERS ( DimTag ) ),
			            "@x", [CL Scatter X Value],
			            "@y", [CL1.PV (kW)]
			        ),
			        NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] )
			    )
			VAR mx = AVERAGEX ( pts, [@x] )
			VAR my = AVERAGEX ( pts, [@y] )
			VAR cov = SUMX ( pts, ( [@x] - mx ) * ( [@y] - my ) )
			VAR vx = SUMX ( pts, ( [@x] - mx ) ^ 2 )
			VAR vy = SUMX ( pts, ( [@y] - my ) ^ 2 )
			RETURN COUNTROWS ( pts )
		formatString: #,0
		lineageTag: 0b458627-0e1b-4e8c-944a-3aea2d806cc4

	measure 'CL Scatter Strength' =
			VAR r = [CL Scatter Pearson r]
			VAR a = ABS ( r )
			RETURN
			    IF (
			        ISBLANK ( r ), "Select a variable",
			        IF (
			            a < 0.2, "Very weak / no link",
			            SWITCH ( TRUE (), a >= 0.8, "Very strong", a >= 0.6, "Strong", a >= 0.4, "Moderate", "Weak" )
			                & IF ( r > 0, " positive", " negative" )
			        )
			    )
		lineageTag: 43ccdfac-514e-442a-a587-e3e03713d0ff

	/// Change in CL1.PV for a sensible step of the ticked variable, e.g. "+123.4 kW (+1.6%) per +1 °C"
	measure 'CL Scatter Effect text' =
			VAR unit = SELECTEDVALUE ( 'CL Combined Variables'[Unit] )
			VAR step = SWITCH ( unit, "kW/RT", 0.01, "m³/h", 100, 1 )
			VAR dCL = [CL Scatter Slope] * step
			VAR pct = DIVIDE ( dCL, CALCULATE ( [CL1.PV (kW)] ) )
			RETURN
			    IF (
			        NOT ISBLANK ( dCL ),
			        FORMAT ( dCL, "+#,0.0;-#,0.0" ) & " kW (" & FORMAT ( pct, "+0.0%;-0.0%" ) & ") per +" & step & " " & unit
			    )
		lineageTag: 0430c4e3-80ad-484c-867e-0cb939b0d6d5

	measure 'CL Scatter Chart Title' =
			VAR short = SELECTEDVALUE ( 'CL Combined Variables'[Short] )
			RETURN
			    IF (
			        ISBLANK ( short ),
			        "Tick a variable on the left",
			        "CL1.PV vs " & short & "   |   Pearson r = " & FORMAT ( [CL Scatter Pearson r], "0.0000" ) & " (" & [CL Scatter Strength] & ")"
			    ) & "   |   " & [Period Title]
		lineageTag: e302e806-fccc-4d00-a49c-fc593e7e9705

	measure 'CL Scatter Page Title' =
			VAR s = MIN ( DimPeriod[StartDateTime] )
			VAR e = MAX ( DimPeriod[EndDateTime] )
			VAR span =
			    IF (
			        FORMAT ( s, "mmm yyyy" ) = FORMAT ( e, "mmm yyyy" ),
			        FORMAT ( s, "mmm yyyy" ),
			        FORMAT ( s, "mmm yyyy" ) & " - " & FORMAT ( e, "mmm yyyy" )
			    )
			RETURN "MT Chiller 1 - Pearson Correlation: CL1.PV (Cooling Load) vs Variable (" & span & ")"
		lineageTag: 8c4749be-ade8-48e8-8426-ec2dc871a2c3

	/// Average Variable page: average of the 1-minute readings for the ticked variable and period
	measure 'AV Period Average' = AVERAGE ( 'Trend'[Value] )
		lineageTag: b8b2c417-3676-4d65-886c-f199e1a0100b

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( DimTag[ShortName] ), "EF.PV2", "0.0000", "TIT3.PV", "0.000", "TIT4.PV", "0.000", "TIT1.PV", "0.00", "TIT2.PV", "0.00", "EF.PV", "0.00", "#,0.00" )

	/// Average Variable page: average over all 5 periods (benchmark line)
	measure 'AV Overall Average' = CALCULATE ( AVERAGE ( 'Trend'[Value] ), REMOVEFILTERS ( DimPeriod ), REMOVEFILTERS ( 'Trend'[Period] ) )
		lineageTag: 208fe594-9dd1-48f3-88c1-e0b55151a2e4

		formatStringDefinition = SWITCH ( SELECTEDVALUE ( DimTag[ShortName] ), "EF.PV2", "0.0000", "TIT3.PV", "0.000", "TIT4.PV", "0.000", "TIT1.PV", "0.00", "TIT2.PV", "0.00", "EF.PV", "0.00", "#,0.00" )

	measure 'AV Y Axis Min' =
			VAR lo = MINX ( ALL ( DimPeriod[Period] ), [AV Period Average] )
			VAR hi = MAXX ( ALL ( DimPeriod[Period] ), [AV Period Average] )
			RETURN lo - ( hi - lo ) * 0.35
		lineageTag: ce0752dd-af1a-4da5-b9ce-d52458e27ec5

	measure 'AV Y Axis Max' =
			VAR lo = MINX ( ALL ( DimPeriod[Period] ), [AV Period Average] )
			VAR hi = MAXX ( ALL ( DimPeriod[Period] ), [AV Period Average] )
			RETURN hi + ( hi - lo ) * 0.35
		lineageTag: f8e9ee53-2d50-4d5d-a336-4f8f69627405

	measure 'AV Chart Title' = SELECTEDVALUE ( DimTag[TagLabel], "Tick one variable on the left" )
		lineageTag: 4a194797-35c5-4649-8ce1-224d8345e2a1

	measure 'AV Diff vs Overall %' = DIVIDE ( [AV Period Average] - [AV Overall Average], [AV Overall Average] )
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: 29062964-fb7c-4606-844d-5033e9fca38d

	/// Value for one row of the custom CL tooltip (blank when that variable is not ticked)
	measure 'CL Tooltip Value' =
			VAR k = SELECTEDVALUE ( 'CL Tooltip Rows'[Short] ) & "|" & SELECTEDVALUE ( 'CL Tooltip Rows'[Kind] )
			RETURN
			SWITCH (
			    k,
			    "CL1.PV|value", [CL1.PV (kW)],
			    "CL1.PV|ref", [CL1.PV Avg Reference (kW)],
			    "EF.PV2|value", [CLc EF.PV2],
			    "EF.PV2|ref", [CLc EF.PV2 Reference],
			    "FIT1.PV|value", [CLc FIT1.PV],
			    "FIT1.PV|ref", [CLc FIT1.PV Reference],
			    "FIT2.PV|value", [CLc FIT2.PV],
			    "FIT2.PV|ref", [CLc FIT2.PV Reference],
			    "TIT1.PV|value", [CLc TIT1.PV],
			    "TIT1.PV|ref", [CLc TIT1.PV Reference],
			    "TIT2.PV|value", [CLc TIT2.PV],
			    "TIT2.PV|ref", [CLc TIT2.PV Reference],
			    "TIT3.PV|value", [CLc TIT3.PV],
			    "TIT3.PV|ref", [CLc TIT3.PV Reference],
			    "TIT4.PV|value", [CLc TIT4.PV],
			    "TIT4.PV|ref", [CLc TIT4.PV Reference],
			    "EF.PV|value", [CLc EF.PV],
			    "EF.PV|ref", [CLc EF.PV Reference]
			)
		formatString: #,0.000
		lineageTag: a1c777ae-607b-488b-9965-b4d315144ea0

	/// Title of the custom CL tooltip: the hovered 30-minute block
	measure 'CL Tooltip Title' = FORMAT ( MIN ( 'Trend'[DateTime 30min] ), "d/m/yyyy  hh:mm" )
		lineageTag: bd8ddf4f-d317-4a0d-b51b-d484e01b4502

	column Period
		dataType: string
		lineageTag: 0c874759-923c-49a7-ad1f-0df3d50a4610
		summarizeBy: none
		sourceColumn: Period

	column DateTime
		dataType: dateTime
		formatString: General Date
		lineageTag: 84a5e57c-4394-4c99-a666-cbb0962149da
		summarizeBy: none
		sourceColumn: DateTime

	column Tag
