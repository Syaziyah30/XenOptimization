	measure '% Time Above Reference' =
			VAR ref = SELECTEDVALUE ( DimTag[ReferenceValue] )
			RETURN
			    IF (
			        NOT ISBLANK ( ref ),
			        DIVIDE ( CALCULATE ( COUNTROWS ( 'Trend' ), 'Trend'[Value] > ref ), COUNTROWS ( 'Trend' ) )
			    )
		formatString: 0.0%
		lineageTag: 13613194-4e04-4098-bcc0-1c0c0910b270

	measure 'Y Axis Min' =
			VAR ref = SELECTEDVALUE ( DimTag[ReferenceValue] )
			VAR lo = CALCULATE ( MIN ( 'Trend'[Value] ), REMOVEFILTERS ( DimPeriod ), REMOVEFILTERS ( 'Trend'[Period] ), REMOVEFILTERS ( 'Trend'[DateTime] ) )
			VAR hi = CALCULATE ( MAX ( 'Trend'[Value] ), REMOVEFILTERS ( DimPeriod ), REMOVEFILTERS ( 'Trend'[Period] ), REMOVEFILTERS ( 'Trend'[DateTime] ) )
			VAR mn = IF ( ISBLANK ( ref ), lo, MIN ( lo, ref ) )
			VAR mx = IF ( ISBLANK ( ref ), hi, MAX ( hi, ref ) )
			RETURN mn - ( mx - mn ) * 0.05
		formatString: #,0.000
		lineageTag: 82bcf883-41f5-422b-bbef-0f560895d897

	measure 'Y Axis Max' =
			VAR ref = SELECTEDVALUE ( DimTag[ReferenceValue] )
			VAR lo = CALCULATE ( MIN ( 'Trend'[Value] ), REMOVEFILTERS ( DimPeriod ), REMOVEFILTERS ( 'Trend'[Period] ), REMOVEFILTERS ( 'Trend'[DateTime] ) )
			VAR hi = CALCULATE ( MAX ( 'Trend'[Value] ), REMOVEFILTERS ( DimPeriod ), REMOVEFILTERS ( 'Trend'[Period] ), REMOVEFILTERS ( 'Trend'[DateTime] ) )
			VAR mn = IF ( ISBLANK ( ref ), lo, MIN ( lo, ref ) )
			VAR mx = IF ( ISBLANK ( ref ), hi, MAX ( hi, ref ) )
			RETURN mx + ( mx - mn ) * 0.05
		formatString: #,0.000
		lineageTag: 319b3124-63e1-4355-9dfc-897b74a5a0a7

