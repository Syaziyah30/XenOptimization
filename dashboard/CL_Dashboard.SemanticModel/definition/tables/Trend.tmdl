	measure 'CL1.PV (kW)' = CALCULATE ( AVERAGE ( 'Trend'[Value] ), DimTag[Tag] = "C10A1_1_C101C_MTCHW_CH01_CL1.PV" )
		formatString: #,0.000
		lineageTag: 3f1c2a6e-8b4d-4e7a-9c51-2d6f0a8b7e11

	measure 'EF.PV2 (kW/RT)' = CALCULATE ( AVERAGE ( 'Trend'[Value] ), DimTag[Tag] = "C10A1_1_C101C_MTCHW_CH01_EF.PV2" )
		formatString: #,0.0000
		lineageTag: 7a2e9d40-1c5b-4f86-b3a7-9e0d4c6f2a22

	measure 'Correlation CL1 vs EF.PV2' =
			VAR pts =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( 'Trend'[DateTime] ), REMOVEFILTERS ( DimTag ) ),
			            "@x", [CL1.PV (kW)],
			            "@y", [EF.PV2 (kW/RT)]
			        ),
			        NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] )
			    )
			VAR mx = AVERAGEX ( pts, [@x] )
			VAR my = AVERAGEX ( pts, [@y] )
			VAR cov = SUMX ( pts, ( [@x] - mx ) * ( [@y] - my ) )
			VAR sx = SQRT ( SUMX ( pts, ( [@x] - mx ) ^ 2 ) )
			VAR sy = SQRT ( SUMX ( pts, ( [@y] - my ) ^ 2 ) )
			RETURN DIVIDE ( cov, sx * sy )
		formatString: 0.00
		lineageTag: c5d8e3b1-6f2a-4b9c-8e47-1a3b5d7f9c33

