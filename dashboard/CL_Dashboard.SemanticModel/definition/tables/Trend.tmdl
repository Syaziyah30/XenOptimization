	/// Page heading with the month of the selected period, e.g. "... Dashboard (Feb 2024)"
	measure 'Combined Page Title' =
			VAR s = MIN ( DimPeriod[StartDateTime] )
			VAR e = MAX ( DimPeriod[EndDateTime] )
			VAR span =
			    IF (
			        FORMAT ( s, "mmm yyyy" ) = FORMAT ( e, "mmm yyyy" ),
			        FORMAT ( s, "mmm yyyy" ),
			        FORMAT ( s, "mmm yyyy" ) & " - " & FORMAT ( e, "mmm yyyy" )
			    )
			RETURN "MT Chiller 1 - Efficiency (EF.PV2) Combined Trend Dashboard (" & span & ")"
		lineageTag: 8b1f4c62-7e3a-4d95-b0c8-2a6e9f1d3b47

	measure 'Combined Chart Title' =
			VAR names =
			    CONCATENATEX (
			        VALUES ( 'Combined Variables'[Variable] ),
			        CALCULATE ( SELECTEDVALUE ( 'Combined Variables'[Short] ) ),
			        ", ",
			        CALCULATE ( MIN ( 'Combined Variables'[Order] ) ), ASC
			    )
			RETURN
			    IF (
			        NOT ISFILTERED ( 'Combined Variables'[Variable] ),
			        "Efficiency EF.PV2 (kW/RT)  -  tick one or more variables on the left to compare",
			        "Combined Trend of " & names & " and Efficiency (EF.PV2)"
			    ) & "   |   " & [Period Title]
		lineageTag: da43a104-7771-4b81-b4b4-dce125c1280b

	/// Pearson correlation of the ticked variable with EF.PV2 over the 30-minute blocks in context
	measure 'Scatter Pearson r' =
			VAR pts =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( 'Trend'[DateTime 30min] ), REMOVEFILTERS ( DimTag ) ),
			            "@x", [Combined Variable Value],
			            "@y", [EF.PV2 (kW/RT)]
			        ),
			        NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] )
			    )
			VAR mx = AVERAGEX ( pts, [@x] )
			VAR my = AVERAGEX ( pts, [@y] )
			VAR cov = SUMX ( pts, ( [@x] - mx ) * ( [@y] - my ) )
			VAR vx = SUMX ( pts, ( [@x] - mx ) ^ 2 )
			VAR vy = SUMX ( pts, ( [@y] - my ) ^ 2 )
			RETURN DIVIDE ( cov, SQRT ( vx ) * SQRT ( vy ) )
		formatString: 0.0000
		lineageTag: e7afc4cd-95ec-4f69-9417-a28a18c599b5

	/// Least-squares slope: change in EF.PV2 (kW/RT) per 1 unit of the ticked variable
	measure 'Scatter Slope' =
			VAR pts =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( 'Trend'[DateTime 30min] ), REMOVEFILTERS ( DimTag ) ),
			            "@x", [Combined Variable Value],
			            "@y", [EF.PV2 (kW/RT)]
			        ),
			        NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] )
			    )
			VAR mx = AVERAGEX ( pts, [@x] )
			VAR my = AVERAGEX ( pts, [@y] )
			VAR cov = SUMX ( pts, ( [@x] - mx ) * ( [@y] - my ) )
			VAR vx = SUMX ( pts, ( [@x] - mx ) ^ 2 )
			VAR vy = SUMX ( pts, ( [@y] - my ) ^ 2 )
			RETURN DIVIDE ( cov, vx )
		formatString: 0.000000
		lineageTag: 0e79f25c-fe6f-45a7-81fe-afc5a59b5b02

	measure 'Scatter Points' =
			VAR pts =
			    FILTER (
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( 'Trend'[DateTime 30min] ), REMOVEFILTERS ( DimTag ) ),
			            "@x", [Combined Variable Value],
			            "@y", [EF.PV2 (kW/RT)]
			        ),
			        NOT ISBLANK ( [@x] ) && NOT ISBLANK ( [@y] )
			    )
			VAR mx = AVERAGEX ( pts, [@x] )
			VAR my = AVERAGEX ( pts, [@y] )
			VAR cov = SUMX ( pts, ( [@x] - mx ) * ( [@y] - my ) )
			VAR vx = SUMX ( pts, ( [@x] - mx ) ^ 2 )
			VAR vy = SUMX ( pts, ( [@y] - my ) ^ 2 )
			RETURN COUNTROWS ( pts )
		formatString: #,0
		lineageTag: 2af4c4cb-baa2-47c8-ac0b-62fce3f0548e

	measure 'Scatter Strength' =
			VAR r = [Scatter Pearson r]
			VAR a = ABS ( r )
			RETURN
			    IF (
			        ISBLANK ( r ), "Select a variable",
			        IF (
			            a < 0.2, "Very weak / no link",
			            SWITCH ( TRUE (), a >= 0.8, "Very strong", a >= 0.6, "Strong", a >= 0.4, "Moderate", "Weak" )
			                & IF ( r > 0, " positive", " negative" )
			        )
			    )
		lineageTag: cd65871a-08a1-4e5d-aa87-39448e761c84

	/// EF.PV2 change for each +1 (or +100 for kW and m³/h) of the ticked variable
	measure 'Scatter Effect text' =
			VAR unit = SELECTEDVALUE ( 'Combined Variables'[Unit] )
			VAR step = IF ( unit IN { "kW", "m³/h" }, 100, 1 )
			VAR dEF = [Scatter Slope] * step
			VAR pct = DIVIDE ( dEF, CALCULATE ( [EF.PV2 (kW/RT)] ) )
			RETURN
			    IF (
			        NOT ISBLANK ( dEF ),
			        FORMAT ( dEF, "+0.0000;-0.0000" ) & " kW/RT (" & FORMAT ( pct, "+0.0%;-0.0%" ) & ") per +" & step & " " & unit
			    )
		lineageTag: 01aa0df4-fdc3-4dce-9f85-59c688177aa5

	measure 'Scatter Chart Title' =
			VAR short = SELECTEDVALUE ( 'Combined Variables'[Short] )
			RETURN
			    IF (
			        ISBLANK ( short ),
			        "Tick a variable on the left",
			        "EF.PV2 vs " & short & "   |   Pearson r = " & FORMAT ( [Scatter Pearson r], "0.0000" ) & " (" & [Scatter Strength] & ")"
			    ) & "   |   " & [Period Title]
		lineageTag: f51202ab-1416-4e0d-8ef6-a0c523e55bf2

	measure 'Scatter Page Title' =
			VAR s = MIN ( DimPeriod[StartDateTime] )
			VAR e = MAX ( DimPeriod[EndDateTime] )
			VAR span =
			    IF (
			        FORMAT ( s, "mmm yyyy" ) = FORMAT ( e, "mmm yyyy" ),
			        FORMAT ( s, "mmm yyyy" ),
			        FORMAT ( s, "mmm yyyy" ) & " - " & FORMAT ( e, "mmm yyyy" )
			    )
			RETURN "MT Chiller 1 - Pearson Correlation: EF.PV2 vs Variable (" & span & ")"
		lineageTag: 447d6cb3-e88a-4201-9ede-ef133014165b

	/// CL1.PV on the Combined page, blank unless it is ticked in the variable list
	measure 'Cmb CL1.PV' =
