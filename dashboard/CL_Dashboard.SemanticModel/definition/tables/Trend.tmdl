	/// Page heading with the month of the selected period, e.g. "... Dashboard (Feb 2024)"
	measure 'CL Combined Page Title' =
			VAR s = MIN ( DimPeriod[StartDateTime] )
			VAR e = MAX ( DimPeriod[EndDateTime] )
			VAR span =
			    IF (
			        FORMAT ( s, "mmm yyyy" ) = FORMAT ( e, "mmm yyyy" ),
			        FORMAT ( s, "mmm yyyy" ),
			        FORMAT ( s, "mmm yyyy" ) & " - " & FORMAT ( e, "mmm yyyy" )
			    )
			RETURN "MT Chiller 1 - Cooling Load (CL1.PV) Combined Trend Dashboard (" & span & ")"
		lineageTag: c3cd89d3-1e95-4f4a-a1da-5c15a90cc3b6

